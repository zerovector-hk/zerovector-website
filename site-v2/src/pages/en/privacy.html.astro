---
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/800.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import Base from '../../layouts/Base.astro';
import LegalDoc from '../../components/LegalDoc.astro';
import base from '../../content/en.js';
import L from '../../content/legal/en.js';
const t = {
  ...base,
  meta: { title: L.privacy.title + ' — ZEROVECTOR', description: L.privacy.metaDesc },
  path: '/en/privacy.html'.replace('//', '/'),
  home: '/en/',
  langHrefs: { tw: '/privacy.html', cn: '/cn/privacy.html', en: '/en/privacy.html' },
  altPaths: { tw: '/privacy.html', cn: '/cn/privacy.html', en: '/en/privacy.html' },
};
---
<Base t={t}>
  <LegalDoc doc={L.privacy} meta={{ kicker: L.kicker, backHome: L.backHome, updatedLabel: L.updatedLabel, home: '/en/' }} />
</Base>
