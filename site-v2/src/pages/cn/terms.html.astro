---
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/800.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/noto-sans-sc/400.css';
import '@fontsource/noto-sans-sc/500.css';
import '@fontsource/noto-sans-sc/700.css';
import Base from '../../layouts/Base.astro';
import LegalDoc from '../../components/LegalDoc.astro';
import base from '../../content/zh-cn.js';
import L from '../../content/legal/zh-cn.js';
const t = {
  ...base,
  meta: { title: L.terms.title + ' — ZEROVECTOR', description: L.terms.metaDesc },
  path: '/cn/terms.html'.replace('//', '/'),
  home: '/cn/',
  langHrefs: { tw: '/terms.html', cn: '/cn/terms.html', en: '/en/terms.html' },
  altPaths: { tw: '/terms.html', cn: '/cn/terms.html', en: '/en/terms.html' },
};
---
<Base t={t}>
  <LegalDoc doc={L.terms} meta={{ backHome: L.backHome, updatedLabel: L.updatedLabel, home: '/cn/' }} />
</Base>
