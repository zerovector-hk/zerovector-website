---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

const { t } = Astro.props;
const site = 'https://zerovector.hk';
const canonical = site + t.path;
const home = t.home ?? '';
const langHrefs = t.langHrefs ?? { tw: '/', cn: '/cn/', en: '/en/' };
const altPaths = t.altPaths ?? { tw: '/', cn: '/cn/', en: '/en/' };
const prefix = (href) => (href.startsWith('#') ? home + href : href);

const orgJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ZEROVECTOR LIMITED',
  alternateName: 'ZEROVECTOR',
  url: site,
  logo: site + '/brand/logo.svg',
  description: t.meta.description,
  email: 'support@zerovector.hk',
  address: { '@type': 'PostalAddress', addressRegion: 'Hong Kong SAR' },
  sameAs: ['https://sealr.io', 'https://merkleclaw.com', 'https://threatledger.net'],
});
---
<!DOCTYPE html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-Hant" href={site + altPaths.tw} />
    <link rel="alternate" hreflang="zh-Hans" href={site + altPaths.cn} />
    <link rel="alternate" hreflang="en" href={site + altPaths.en} />
    <link rel="alternate" hreflang="x-default" href={site + altPaths.tw} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="ZEROVECTOR" />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#0B1F3A" />
    <script type="application/ld+json" set:html={orgJsonLd} />
    <script is:inline>
      if ('IntersectionObserver' in window) document.documentElement.classList.add('js');
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header">
      <nav class="nav wrap" aria-label="Main">
        <a class="nav-logo" href={t.path} aria-label="ZEROVECTOR">
          <svg viewBox="0 0 56 56" aria-hidden="true">
            <path d="M6 17 V10 a3.5 3.5 0 0 1 3.5-3.5 H17" fill="none" stroke="#0B1F3A" stroke-width="4.5"/>
            <path d="M39 6.5 h7.5 a3.5 3.5 0 0 1 3.5 3.5 v7" fill="none" stroke="#0B1F3A" stroke-width="4.5"/>
            <path d="M50 39 v7 a3.5 3.5 0 0 1-3.5 3.5 H39" fill="none" stroke="#0B1F3A" stroke-width="4.5"/>
            <path d="M17 49.5 H9.5 A3.5 3.5 0 0 1 6 46 v-7" fill="none" stroke="#0B1F3A" stroke-width="4.5"/>
            <line x1="14.5" y1="28" x2="41.5" y2="28" stroke="#94A3B8" stroke-width="1.8"/>
            <line x1="28" y1="14.5" x2="28" y2="41.5" stroke="#94A3B8" stroke-width="1.8"/>
            <circle cx="28" cy="28" r="6.2" fill="#1D4ED8"/>
          </svg>
          <span class="word">ZEROVECTOR</span>
        </a>

        <input type="checkbox" id="menu-toggle" class="menu-toggle" aria-hidden="true" />
        <div class="nav-links" id="nav-links">
          <a href={home + '#services'}>{t.nav.services}</a>
          <a href={home + '#products'}>{t.nav.products}</a>
          <a href={home + '#technology'}>{t.nav.technology}</a>
          <a href={home + '#about'}>{t.nav.about}</a>
          <div class="lang-switch" aria-label="Language">
            <a href={langHrefs.tw} aria-current={t.lang === 'zh-TW' ? 'true' : undefined}>繁</a>
            <a href={langHrefs.cn} aria-current={t.lang === 'zh-CN' ? 'true' : undefined}>简</a>
            <a href={langHrefs.en} aria-current={t.lang === 'en' ? 'true' : undefined}>EN</a>
          </div>
          <a class="nav-cta" href={home + '#contact'}>{t.nav.cta}</a>
        </div>
        <label for="menu-toggle" class="menu-btn" aria-label={t.nav.menuLabel}>
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
        </label>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div class="footer-brand">
            <svg width="176" height="34" viewBox="0 0 300 58" aria-label="ZEROVECTOR">
              <g>
                <path d="M6 17 V10 a3.5 3.5 0 0 1 3.5-3.5 H17" fill="none" stroke="#E2E8F0" stroke-width="4.5"/>
                <path d="M39 6.5 h7.5 a3.5 3.5 0 0 1 3.5 3.5 v7" fill="none" stroke="#E2E8F0" stroke-width="4.5"/>
                <path d="M50 39 v7 a3.5 3.5 0 0 1-3.5 3.5 H39" fill="none" stroke="#E2E8F0" stroke-width="4.5"/>
                <path d="M17 49.5 H9.5 A3.5 3.5 0 0 1 6 46 v-7" fill="none" stroke="#E2E8F0" stroke-width="4.5"/>
                <line x1="14.5" y1="28" x2="41.5" y2="28" stroke="#64748B" stroke-width="1.8"/>
                <line x1="28" y1="14.5" x2="28" y2="41.5" stroke="#64748B" stroke-width="1.8"/>
                <circle cx="28" cy="28" r="6.2" fill="#60A5FA"/>
              </g>
              <text x="72" y="34" font-family="Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif" font-size="21" font-weight="800" letter-spacing="2.2" fill="#FFFFFF">ZEROVECTOR</text>
              <text x="73.5" y="49" font-family="Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif" font-size="9" font-weight="500" letter-spacing="2.8" fill="#94A3B8">REGTECH · HONG KONG</text>
            </svg>
            <p>{t.footer.tagline}</p>
          </div>
          {t.footer.cols.map((col) => (
            <div class="footer-col">
              <h4>{col.title}</h4>
              {col.links.map((l) => (
                <a href={prefix(l.href)} target={l.href.startsWith('http') ? '_blank' : undefined} rel={l.href.startsWith('http') ? 'noopener' : undefined}>{l.text}</a>
              ))}
            </div>
          ))}
        </div>
        <div class="footer-scope">
          <p>{t.footer.statsNote}</p>
        </div>
        <div class="footer-base">
          <span>© {new Date().getFullYear()} {t.footer.copyright}</span>
          <span>
            {t.footer.legal.map((l, i) => (
              <>
                <a href={l.href}>{l.text}</a>{i < t.footer.legal.length - 1 ? ' · ' : ''}
              </>
            ))}
          </span>
        </div>
      </div>
    </footer>

    <script>
      function initReveal() {
        const els = document.querySelectorAll('.reveal:not(.in)');
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -36px 0px' }
        );
        els.forEach((el) => io.observe(el));
      }
      function initHeader() {
        if (window.__zvHeader) return;
        window.__zvHeader = true;
        const onScroll = () => {
          const h = document.querySelector('.site-header');
          if (h) h.classList.toggle('scrolled', window.scrollY > 8);
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }
      initReveal();
      initHeader();
      document.addEventListener('astro:page-load', () => {
        initReveal();
        initHeader();
      });
    </script>
  </body>
</html>
