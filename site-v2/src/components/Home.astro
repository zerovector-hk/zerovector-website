---
const { t } = Astro.props;

const icons = {
  graph: `<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"><circle cx="6" cy="6" r="2.6"/><circle cx="18" cy="8" r="2.6"/><circle cx="10" cy="18" r="2.6"/><line x1="8.2" y1="7.1" x2="15.5" y2="7.6"/><line x1="7" y1="8.4" x2="9.2" y2="15.7"/><line x1="16.4" y1="10.2" x2="11.8" y2="16.3"/></svg>`,
  lock: `<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10.5" width="14" height="9.5" rx="2.5"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/><circle cx="12" cy="15.2" r="1.6"/></svg>`,
  doc: `<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5"/><line x1="9" y1="13" x2="16" y2="13"/><line x1="9" y1="17" x2="14" y2="17"/></svg>`,
  gov: `<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V8l7-5 7 5v13"/><line x1="9" y1="12" x2="9" y2="17"/><line x1="15" y1="12" x2="15" y2="17"/></svg>`,
};

const techIcons = [
  `<svg viewBox="0 0 24 24" fill="none" stroke="#93C5FD" stroke-width="1.7" stroke-linecap="round"><circle cx="5" cy="12" r="2.2"/><circle cx="13" cy="5.5" r="2.2"/><circle cx="13" cy="18.5" r="2.2"/><circle cx="20" cy="12" r="2.2"/><line x1="6.8" y1="10.6" x2="11.2" y2="6.9"/><line x1="6.8" y1="13.4" x2="11.2" y2="17.1"/><line x1="14.9" y1="6.8" x2="18.5" y2="10.5"/><line x1="14.9" y1="17.2" x2="18.5" y2="13.5"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="#93C5FD" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19c3-1 4-8 8-9s5 3 8 2"/><circle cx="4" cy="19" r="1.8" fill="#93C5FD" stroke="none"/><circle cx="20" cy="12" r="1.8" fill="#93C5FD" stroke="none"/><path d="M14 4l2.5 2.5L14 9"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="#93C5FD" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5"/><path d="M9.5 14.5l2 2 3.5-4"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="#93C5FD" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="9.5" width="7" height="5" rx="2.4"/><rect x="13.5" y="9.5" width="7" height="5" rx="2.4"/><line x1="10.5" y1="12" x2="13.5" y2="12"/></svg>`,
];
---

<!-- ═══ Hero ═══ -->
<section class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="wrap hero-grid">
    <div>
      <p class="eyebrow enter e1">{t.hero.eyebrow}</p>
      <h1><span class="enter e2">{t.hero.h1[0]}</span><br /><span class="enter e3">{t.hero.h1[1]}</span></h1>
      <p class="lead enter e4">{t.hero.lead}</p>
      <div class="hero-ctas enter e5">
        <a class="btn btn-primary" href="#contact">{t.hero.cta1}</a>
        <a class="btn btn-secondary" href="#services">{t.hero.cta2}</a>
      </div>
    </div>
    <div class="hero-art enter e3" aria-hidden="true">
      <svg viewBox="0 0 460 300" fill="none">
        <defs>
          <linearGradient id="tg" x1="0" y1="1" x2="1" y2="0">
            <stop offset="0%" stop-color="#2563EB"/><stop offset="100%" stop-color="#60A5FA"/>
          </linearGradient>
          <pattern id="hgrid" width="26" height="26" patternUnits="userSpaceOnUse">
            <path d="M26 0H0V26" fill="none" stroke="#EDF2F9" stroke-width="1"/>
          </pattern>
          <filter id="dotglow" x="-80%" y="-80%" width="260%" height="260%">
            <feDropShadow dx="0" dy="0" stdDeviation="3.2" flood-color="#3B82F6" flood-opacity="0.75"/>
          </filter>
        </defs>
        <rect x="0" y="0" width="460" height="300" fill="url(#hgrid)" opacity="0.9"/>
        <!-- ambient network (context) -->
        <g class="net-line">
          <line x1="40" y1="60" x2="118" y2="42" stroke="#E2E8F0" stroke-width="1.5"/>
          <line x1="118" y1="42" x2="170" y2="100" stroke="#E2E8F0" stroke-width="1.5"/>
          <line x1="288" y1="150" x2="352" y2="228" stroke="#E2E8F0" stroke-width="1.5"/>
          <line x1="352" y1="228" x2="420" y2="196" stroke="#E2E8F0" stroke-width="1.5"/>
          <line x1="392" y1="118" x2="424" y2="60" stroke="#E2E8F0" stroke-width="1.5"/>
          <circle cx="40" cy="60" r="3.4" fill="#E2E8F0"/>
          <circle cx="118" cy="42" r="3.4" fill="#E2E8F0"/>
          <circle cx="424" cy="60" r="3.4" fill="#E2E8F0"/>
          <circle cx="352" cy="228" r="3.4" fill="#E2E8F0"/>
          <circle cx="420" cy="196" r="3.4" fill="#E2E8F0"/>
        </g>
        <!-- known graph -->
        <line class="net-line" x1="70" y1="205" x2="170" y2="100" stroke="#CBD5E1" stroke-width="2"/>
        <line class="net-line" x1="70" y1="205" x2="192" y2="228" stroke="#CBD5E1" stroke-width="2"/>
        <line class="net-line" x1="170" y1="100" x2="288" y2="150" stroke="#CBD5E1" stroke-width="2"/>
        <line class="net-line" x1="192" y1="228" x2="288" y2="150" stroke="#94A3B8" stroke-width="2" stroke-dasharray="6 5"/>
        <!-- attribution trace -->
        <path class="trace-path" d="M70 205 L170 100 L288 150 L392 118" pathLength="100" stroke="url(#tg)" stroke-width="3"/>
        <circle class="tn n1" cx="70" cy="205" r="9" fill="#fff" stroke="#334155" stroke-width="2.4"/>
        <circle class="tn n2" cx="170" cy="100" r="9" fill="#fff" stroke="#334155" stroke-width="2.4"/>
        <circle class="tn n3" cx="192" cy="228" r="9" fill="#fff" stroke="#334155" stroke-width="2.4"/>
        <circle class="tn n4" cx="288" cy="150" r="10" fill="#EFF4FF" stroke="#1D4ED8" stroke-width="2.4"/>
        <g class="tn n5">
          <circle class="pulse-ring" cx="392" cy="118" r="12" fill="none" stroke="#1D4ED8" stroke-width="2"/>
          <circle cx="392" cy="118" r="12" fill="#1D4ED8"/>
          <circle cx="392" cy="118" r="4" fill="#fff"/>
        </g>
        <!-- hash labels -->
        <text class="tn n1" x="52" y="188" font-family="'IBM Plex Mono',Menlo,monospace" font-size="9" fill="#94A3B8">0x4f3a…9e</text>
        <text class="tn n4" x="264" y="176" font-family="'IBM Plex Mono',Menlo,monospace" font-size="9" fill="#94A3B8">0x8c41…07</text>
        <circle class="flow-dot" r="4.5" fill="#60A5FA" filter="url(#dotglow)"/>
      </svg>
      <div class="attr-chip">{t.hero.chip}</div>
      <div class="ticker" aria-hidden="true">
        <span class="tk1">{t.hero.ticker[0]}</span>
        <span class="tk2">{t.hero.ticker[1]}</span>
        <span class="tk3">{t.hero.ticker[2]}</span>
      </div>
    </div>
  </div>
</section>

<!-- ═══ Trust bar ═══ -->
<section class="trust" aria-label="Key facts">
  <div class="wrap">
    <div class="trust-grid">
      {t.trust.map((item, i) => {
        const m = item.num.match(/^(\d+)(.*)$/);
        return (
          <div class="reveal" style={`--d:${i * 0.08}s`}>
            {m ? (
              <b><span class="count" data-n={m[1]}>0</span>{m[2]}</b>
            ) : (
              <b>{item.num}</b>
            )}
            <span>{item.label}</span>
          </div>
        );
      })}
    </div>
  </div>
</section>

<!-- ═══ Services ═══ -->
<section class="sec sec-alt" id="services">
  <div class="wrap">
    <p class="sec-num reveal"><span>01</span></p>
    <h2 class="reveal">{t.services.title}</h2>
    <p class="sub reveal">{t.services.sub}</p>
    <div class="svc-grid">
      {t.services.items.map((s, i) => (
        <article class="svc-card reveal" style={`--d:${i * 0.07}s`}>
          <div class="svc-ic" set:html={icons[s.icon]} />
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ═══ Products ═══ -->
<section class="sec" id="products">
  <div class="wrap">
    <p class="sec-num reveal"><span>02</span></p>
    <h2 class="reveal">{t.products.title}</h2>
    <p class="sub reveal">{t.products.sub}</p>
    <div class="prod-grid">
      {t.products.items.map((p, i) => (
        <article class="prod-card reveal" style={`--d:${i * 0.09}s`}>
          <div class="prod-head">
            <span class={'prod-logo' + (p.logo?.fill ? ' fill' : '')}>
              <img src={p.logo.src} alt={p.name + ' logo'} loading="lazy" />
            </span>
            <div>
              <h3>{p.name}</h3>
              {p.status && (
                <p class="prod-status">{p.live && <span class="dot-live" aria-hidden="true"></span>}{p.status}</p>
              )}
            </div>
          </div>
          <p>{p.desc}</p>
          {p.chains && <p class="chains-line">{p.chains}</p>}
          {p.link && <a class="prod-link" href={p.link.href} target="_blank" rel="noopener">{p.link.text}<span class="arr">→</span></a>}
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ═══ Technology pipeline (dark) ═══ -->
<section class="sec tech" id="technology">
  <div class="wrap">
    <p class="sec-num dark reveal"><span>03</span></p>
    <h2 class="reveal">{t.tech.title}</h2>
    <p class="sub reveal">{t.tech.sub}</p>
    <ol class="pipeline">
      {t.tech.stages.map((st, i) => (
        <li class="stage reveal" style={`--d:${i * 0.12}s`}>
          <div class="s-ic" set:html={techIcons[i]} />
          <div class="s-body">
            <h3><span class="s-idx">{String(i + 1).padStart(2, '0')}</span>{st.title}</h3>
            <p>{st.desc}</p>
            <p class="s-tag">{st.tag}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="tech-note reveal"><p>{t.tech.note}</p></div>
  </div>
</section>

<!-- ═══ About + Contact ═══ -->
<section class="sec" id="about">
  <div class="wrap about-grid">
    <div class="about-body">
      <p class="sec-num reveal"><span>04</span></p>
      <h2 class="reveal" style="font-size:clamp(26px,3.4vw,34px);font-weight:700;color:var(--navy-900);letter-spacing:-.01em;line-height:1.3">{t.about.title}</h2>
      {t.about.body.map((para) => <p class="reveal">{para}</p>)}
      <p class="about-quote reveal">{t.about.quote}</p>
    </div>
    <div class="contact-card reveal" id="contact" style="--d:.12s">
      <h3>{t.contact.title}</h3>
      <p>{t.contact.desc}</p>
      <a class="btn btn-primary" href={'mailto:' + t.contact.email} style="width:100%">{t.contact.cta}</a>
      <div style="margin-top:22px">
        <div class="contact-row">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M4 7l8 6 8-6"/></svg>
          <span>{t.contact.emailLabel}：<a href={'mailto:' + t.contact.email} class="mono">{t.contact.email}</a></span>
        </div>
        <div class="contact-row">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.2 2"/></svg>
          <span>{t.contact.responseNote}</span>
        </div>
      </div>
    </div>
  </div>
</section>
