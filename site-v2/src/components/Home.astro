---
const { t } = Astro.props;

const icons = {
  graph: `<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"><circle cx="6" cy="6" r="2.6"/><circle cx="18" cy="8" r="2.6"/><circle cx="10" cy="18" r="2.6"/><line x1="8.2" y1="7.1" x2="15.5" y2="7.6"/><line x1="7" y1="8.4" x2="9.2" y2="15.7"/><line x1="16.4" y1="10.2" x2="11.8" y2="16.3"/></svg>`,
  scale: `<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><path d="M8 21h8"/><path d="M4 7h16"/><path d="M7 7l-3 6a3.5 3.5 0 0 0 6 0l-3-6z"/><path d="M17 7l-3 6a3.5 3.5 0 0 0 6 0l-3-6z"/></svg>`,
  lock: `<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10.5" width="14" height="9.5" rx="2.5"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/><circle cx="12" cy="15.2" r="1.6"/></svg>`,
  doc: `<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5"/><line x1="9" y1="13" x2="16" y2="13"/><line x1="9" y1="17" x2="14" y2="17"/></svg>`,
  gov: `<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V8l7-5 7 5v13"/><line x1="9" y1="12" x2="9" y2="17"/><line x1="15" y1="12" x2="15" y2="17"/></svg>`,
};
---

<!-- ═══ Hero ═══ -->
<section class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="wrap hero-grid">
    <div>
      <p class="eyebrow enter e1">{t.hero.eyebrow}</p>
      <h1><span class="enter e2">{t.hero.h1[0]}</span><br /><span class="enter e3">{t.hero.h1[1]}</span></h1>
      <p class="lead enter e4">{t.hero.lead}</p>
      <div class="hero-ctas enter e5">
        <a class="btn btn-primary" href="#contact">{t.hero.cta1}</a>
        <a class="btn btn-secondary" href="#services">{t.hero.cta2}</a>
      </div>
    </div>
    <div class="hero-art enter e3" aria-hidden="true">
      <svg viewBox="0 0 460 300" fill="none">
        <line class="net-line" x1="70" y1="205" x2="170" y2="100" stroke="#CBD5E1" stroke-width="2"/>
        <line class="net-line" x1="70" y1="205" x2="192" y2="228" stroke="#CBD5E1" stroke-width="2"/>
        <line class="net-line" x1="170" y1="100" x2="288" y2="150" stroke="#CBD5E1" stroke-width="2"/>
        <line class="net-line" x1="192" y1="228" x2="288" y2="150" stroke="#94A3B8" stroke-width="2" stroke-dasharray="6 5"/>
        <path class="trace-path" d="M70 205 L170 100 L288 150 L392 118" pathLength="100" stroke="#1D4ED8" stroke-width="2.6"/>
        <circle class="tn n1" cx="70" cy="205" r="9" fill="#fff" stroke="#334155" stroke-width="2.4"/>
        <circle class="tn n2" cx="170" cy="100" r="9" fill="#fff" stroke="#334155" stroke-width="2.4"/>
        <circle class="tn n3" cx="192" cy="228" r="9" fill="#fff" stroke="#334155" stroke-width="2.4"/>
        <circle class="tn n4" cx="288" cy="150" r="10" fill="#EFF4FF" stroke="#1D4ED8" stroke-width="2.4"/>
        <g class="tn n5">
          <circle class="pulse-ring" cx="392" cy="118" r="12" fill="none" stroke="#1D4ED8" stroke-width="2"/>
          <circle cx="392" cy="118" r="12" fill="#1D4ED8"/>
          <circle cx="392" cy="118" r="4" fill="#fff"/>
        </g>
        <circle class="flow-dot" r="4" fill="#60A5FA"/>
      </svg>
      <p class="cap">{t.hero.artCaption}</p>
    </div>
  </div>
</section>

<!-- ═══ Trust bar ═══ -->
<section class="trust" aria-label="Key facts">
  <div class="wrap">
    <div class="trust-grid">
      {t.trust.map((item, i) => (
        <div class="reveal" style={`--d:${i * 0.08}s`}><b>{item.num}</b><span>{item.label}</span></div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ Services ═══ -->
<section class="sec sec-alt" id="services">
  <div class="wrap">
    <p class="eyebrow reveal">{t.services.eyebrow}</p>
    <h2 class="reveal">{t.services.title}</h2>
    <p class="sub reveal">{t.services.sub}</p>
    <div class="svc-grid">
      {t.services.items.map((s, i) => (
        <article class="svc-card reveal" style={`--d:${i * 0.07}s`}>
          <div class="svc-ic" set:html={icons[s.icon]} />
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ═══ Products ═══ -->
<section class="sec" id="products">
  <div class="wrap">
    <p class="eyebrow reveal">{t.products.eyebrow}</p>
    <h2 class="reveal">{t.products.title}</h2>
    <p class="sub reveal">{t.products.sub}</p>
    <div class="prod-grid">
      {t.products.items.map((p, i) => (
        <article class="prod-card reveal" style={`--d:${i * 0.09}s`}>
          <div class="prod-head">
            <span class={'prod-logo' + (p.logo?.fill ? ' fill' : '')}>
              <img src={p.logo.src} alt={p.name + ' logo'} loading="lazy" />
            </span>
            <div>
              <h3>{p.name}</h3>
              {p.status && (
                <p class="prod-status">{p.live && <span class="dot-live" aria-hidden="true"></span>}{p.status}</p>
              )}
            </div>
          </div>
          <p>{p.desc}</p>
          {p.chains && <p class="chains-line">{p.chains}</p>}
          {p.link && <a class="prod-link" href={p.link.href} target="_blank" rel="noopener">{p.link.text}<span class="arr">→</span></a>}
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ═══ Technology (dark) ═══ -->
<section class="sec tech" id="technology">
  <div class="wrap">
    <p class="eyebrow reveal">{t.tech.eyebrow}</p>
    <h2 class="reveal">{t.tech.title}</h2>
    <p class="sub reveal">{t.tech.sub}</p>
    <div class="tech-grid">
      {t.tech.items.map((item, i) => (
        <article class="tech-card reveal" style={`--d:${i * 0.07}s`}>
          <h3>{item.title}</h3>
          <p>{item.desc}</p>
        </article>
      ))}
    </div>
    <div class="tech-note reveal"><p>{t.tech.note}</p></div>
  </div>
</section>

<!-- ═══ About + Contact ═══ -->
<section class="sec" id="about">
  <div class="wrap about-grid">
    <div class="about-body">
      <p class="eyebrow reveal">{t.about.eyebrow}</p>
      <h2 class="reveal" style="font-size:clamp(26px,3.4vw,34px);font-weight:700;color:var(--navy-900);letter-spacing:-.01em;line-height:1.3">{t.about.title}</h2>
      {t.about.body.map((para) => <p class="reveal">{para}</p>)}
      <div class="about-facts reveal" style="margin-top:24px">
        {t.about.facts.map((f) => (
          <div class="fact"><b>{f.b}</b><span>{f.s}</span></div>
        ))}
      </div>
    </div>
    <div class="contact-card reveal" id="contact" style="--d:.12s">
      <h3>{t.contact.title}</h3>
      <p>{t.contact.desc}</p>
      <a class="btn btn-primary" href={'mailto:' + t.contact.email} style="width:100%">{t.contact.cta}</a>
      <div style="margin-top:22px">
        <div class="contact-row">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M4 7l8 6 8-6"/></svg>
          <span>{t.contact.emailLabel}：<a href={'mailto:' + t.contact.email} class="mono">{t.contact.email}</a></span>
        </div>
        <div class="contact-row">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.2 2"/></svg>
          <span>{t.contact.responseNote}</span>
        </div>
      </div>
    </div>
  </div>
</section>
